<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Usuários - SGS</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="site-header"><div class="container"><p class="site-title">Sistema de Gestão de Solicitações</p></div></header>

    <main class="page-card">
        <h1 class="page-heading">Usuários</h1>

        <nav aria-label="Navegação principal" class="navigation">
            <a href="/">Home</a>
            <a href="/usuarios/cadastrar">Novo Usuário</a>
            <a href="/solicitacoes">Solicitações</a>
            <a href="/solicitacoes/aprovacao">Aprovação</a>
        </nav>

        <div class="table-wrapper">
            <table>
                <caption>Lista de usuários cadastrados</caption>
                <thead>
                    <tr>
                        <th scope="col">Nome</th>
                        <th scope="col">Email</th>
                        <th scope="col">Setor</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each usuarios}}
                    <tr>
                        <td>{{nome}}</td>
                        <td>{{email}}</td>
                        <td>{{setor}}</td>
                        <td>{{tipo}}</td>
                        <td>
                            <div class="actions">
                                <a href="/usuarios/{{id}}/editar" class="btn-secondary" aria-label="Editar usuário {{nome}}">Editar</a>
                                <a href="/usuarios/{{id}}/excluir" class="btn-danger" aria-label="Excluir usuário {{nome}}" onclick="return confirm('Deseja excluir este usuário?')">Excluir</a>
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </main>
</body>
</html>