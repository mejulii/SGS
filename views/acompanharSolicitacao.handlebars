<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Acompanhar Solicitação - SGS
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

<header class="site-header">

    <div class="container">

        <p class="site-title">
            Sistema de Gestão de Solicitações
        </p>

    </div>

</header>

<main class="page-card medium">

    <a
        href="/solicitacoes"
        class="voltar"
    >
        Voltar para solicitações
    </a>

    <h1 class="page-heading">
        Acompanhar Solicitação
    </h1>

    <div class="form-box">

        <h2>
            {{solicitacao.titulo}}
        </h2>

        <p>
            {{solicitacao.descricao}}
        </p>

        <br>

        <div class="card-grid">

            <div class="info-card">

                <h3>
                    Status
                </h3>

                <p>

                    <span
                        class="status status-{{solicitacao.status}}"
                    >
                        {{solicitacao.status}}
                    </span>

                </p>

            </div>

            <div class="info-card">

                <h3>
                    Etapa atual
                </h3>

                {{#ifEquals solicitacao.status "pendente"}}

                    <p>
                        Ainda não iniciada
                    </p>

                {{else}}

                    {{#ifEquals solicitacao.etapa "analise"}}

                        <p>
                            Em análise para compra
                        </p>

                    {{else}}

                        {{#ifEquals solicitacao.etapa "compra"}}

                            <p>
                                Em processo de compra
                            </p>

                        {{else}}

                            {{#ifEquals solicitacao.etapa "entrega"}}

                                <p>
                                    Processo de entrega
                                </p>

                            {{else}}

                                {{#ifEquals solicitacao.etapa "finalizada"}}

                                    <p>
                                        Finalizada
                                    </p>

                                {{else}}

                                    {{#ifEquals solicitacao.status "rejeitada"}}

                                        <p>
                                            Solicitação rejeitada
                                        </p>

                                    {{else}}

                                        <p>
                                            Ainda não iniciada
                                        </p>

                                    {{/ifEquals}}

                                {{/ifEquals}}

                            {{/ifEquals}}

                        {{/ifEquals}}

                    {{/ifEquals}}

                {{/ifEquals}}

            </div>

            <div class="info-card">

                <h3>
                    Prioridade
                </h3>

                <p>
                    {{solicitacao.prioridade}}
                </p>

            </div>

            <div class="info-card">

                <h3>
                    Solicitante
                </h3>

                <p>
                    {{solicitacao.Usuario.nome}}
                </p>

            </div>

        </div>

    </div>


    {{#if solicitacao.motivoRejeicao}}

        <div class="form-box">

            <h2>
                Motivo da rejeição
            </h2>

            <p>
                {{solicitacao.motivoRejeicao}}
            </p>

        </div>

    {{/if}}


    {{#ifEquals solicitacao.status "pendente"}}

        {{#if isAdmin}}

            <div class="form-box">

                <h3>
                    Decisão da solicitação
                </h3>

                <p>
                    Analise as informações acima antes de decidir se a solicitação será aprovada ou rejeitada.
                </p>

                <br>

                <div class="actions">

                    <form
                        action="/solicitacoes/{{solicitacao.id}}/aprovar"
                        method="POST"
                        onsubmit="return confirm('Deseja aprovar esta solicitação?')"
                    >

                        <button
                            type="submit"
                            class="btn-success"
                        >
                            Aprovar
                        </button>

                    </form>


                    <form
                        action="/solicitacoes/{{solicitacao.id}}/rejeitar"
                        method="POST"
                        onsubmit="return confirm('Deseja rejeitar esta solicitação?')"
                    >

                        <div class="form-group">

                            <label for="motivoRejeicao">
                                Motivo da rejeição
                            </label>

                            <textarea
                                id="motivoRejeicao"
                                name="motivoRejeicao"
                                rows="4"
                                placeholder="Informe obrigatoriamente o motivo da rejeição."
                                required
                            ></textarea>

                        </div>

                        <button
                            type="submit"
                            class="btn-danger"
                        >
                            Rejeitar
                        </button>

                    </form>

                </div>

            </div>

        {{/if}}

    {{/ifEquals}}


    {{#ifEquals solicitacao.status "aprovada"}}

        {{#if isAdmin}}

            <div class="form-box">

                <h3>
                    Atualizar etapa
                </h3>

                <form
                    action="/solicitacoes/{{solicitacao.id}}/etapa"
                    method="POST"
                >

                    <div class="form-group">

                        <label for="etapa">
                            Nova etapa
                        </label>

                        <select
                            id="etapa"
                            name="etapa"
                            required
                        >

                            <option value="">
                                Selecione...
                            </option>

                            <option value="analise">
                                Em análise para compra
                            </option>

                            <option value="compra">
                                Em processo de compra
                            </option>

                            <option value="entrega">
                                Processo de entrega
                            </option>

                            <option value="finalizada">
                                Finalizada
                            </option>

                        </select>

                    </div>

                    <button
                        type="submit"
                        class="btn-primary"
                    >
                        Atualizar etapa
                    </button>

                </form>

            </div>

        {{/if}}

    {{/ifEquals}}

</main>

</body>

</html>