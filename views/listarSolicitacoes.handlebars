<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitações - SGS</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="site-header"><div class="container"><p class="site-title">Sistema de Gestão de Solicitações</p></div></header>

    <main class="page-card">
        <h1 class="page-heading">Solicitações</h1>
    
        <nav aria-label="Navegação principal" class="navigation">
            <a href="/">Home</a>
            <a href="/solicitacoes/cadastrar">Nova Solicitação</a>
            <a href="/usuarios">Usuários</a>
            <a href="/solicitacoes/aprovacao">Aprovação</a>
        </nav>

        <div class="table-wrapper">
            <table>
                <caption>Lista de solicitações cadastradas</caption>
                <thead>
                    <tr>
                        <th scope="col">Título</th>
                        <th scope="col">Solicitante</th>
                        <th scope="col">Prioridade</th>
                        <th scope="col">Status</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each solicitacoes}}
                    <tr>
                        <td>{{titulo}}</td>
                        <td>{{Usuario.nome}}</td>
                        <td>{{prioridade}}</td>
                        <td><span class="status status-{{status}}">{{status}}</span></td>
                        <td>
                            <div class="actions">
   <a href="/solicitacoes/{{id}}/acompanhar"
    class="btn-primary"
    aria-label="Acompanhar solicitação {{titulo}}"
>
    Acompanhar
</a>

{{#ifEquals status "pendente"}}

    {{#unless ../isAdmin}}

        <a
            href="/solicitacoes/{{id}}/editar"
            class="btn-secondary"
            aria-label="Editar solicitação {{titulo}}"
        >
            Editar
        </a>

        <a
            href="/solicitacoes/{{id}}/excluir"
            class="btn-danger"
            aria-label="Excluir solicitação {{titulo}}"
            onclick="return confirm('Deseja excluir esta solicitação?')"
        >
            Excluir
        </a>

    {{/unless}}

{{/ifEquals}}
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </main>
</body>
</html>