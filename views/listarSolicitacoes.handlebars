<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Solicitações - SGS
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

<header class="site-header">

    <div class="container">

        <p class="site-title">
            Sistema de Gestão de Solicitações
        </p>

    </div>

</header>

<main class="page-card">

    <h1 class="page-heading">
        Solicitações
    </h1>

    <nav
        aria-label="Navegação principal"
        class="navigation"
    >

        <a href="/">
            Home
        </a>

        {{#if isAdmin}}

            <a href="/usuarios">
                Usuários
            </a>

            <a href="/solicitacoes/aprovacao">
                Aprovação
            </a>

        {{else}}

            <a href="/solicitacoes/cadastrar">
                Nova Solicitação
            </a>

        {{/if}}

    </nav>

    <div class="table-wrapper">

        <table>

            <caption>
                Lista de solicitações cadastradas
            </caption>

            <thead>

                <tr>

                    <th scope="col">
                        Título
                    </th>

                    <th scope="col">
                        Solicitante
                    </th>

                    <th scope="col">
                        Prioridade
                    </th>

                    <th scope="col">
                        Status
                    </th>

                    <th scope="col">
                        Ações
                    </th>

                </tr>

            </thead>

            <tbody>

                {{#each solicitacoes}}

                <tr>

                    <td>
                        {{titulo}}
                    </td>

                    <td>
                        {{Usuario.nome}}
                    </td>

                    <td>
                        {{prioridade}}
                    </td>

                    <td>

                        <span
                            class="status status-{{status}}"
                        >
                            {{status}}
                        </span>

                    </td>

                    <td>

                        <div class="actions">

                            {{#if ../isAdmin}}

                                {{#ifEquals status "pendente"}}

                                    <a
                                        href="/solicitacoes/{{id}}/acompanhar"
                                        class="btn-primary"
                                    >
                                        Ver solicitação
                                    </a>

                                {{else}}

                                    <a
                                        href="/solicitacoes/{{id}}/acompanhar"
                                        class="btn-primary"
                                    >
                                        Acompanhar
                                    </a>

                                {{/ifEquals}}

                                {{#ifEquals status "aprovada"}}

                                    <a
                                        href="/solicitacoes/{{id}}/excluir"
                                        class="btn-danger"
                                        onclick="return confirm('Deseja excluir esta solicitação resolvida?')"
                                    >
                                        Excluir
                                    </a>

                                {{/ifEquals}}

                                {{#ifEquals status "rejeitada"}}

                                    <a
                                        href="/solicitacoes/{{id}}/excluir"
                                        class="btn-danger"
                                        onclick="return confirm('Deseja excluir esta solicitação resolvida?')"
                                    >
                                        Excluir
                                    </a>

                                {{/ifEquals}}

                            {{else}}

                                <a
                                    href="/solicitacoes/{{id}}/acompanhar"
                                    class="btn-primary"
                                >
                                    Acompanhar
                                </a>

                                {{#ifEquals status "pendente"}}

                                    <a
                                        href="/solicitacoes/{{id}}/editar"
                                        class="btn-secondary"
                                    >
                                        Editar
                                    </a>

                                    <a
                                        href="/solicitacoes/{{id}}/excluir"
                                        class="btn-danger"
                                        onclick="return confirm('Deseja excluir esta solicitação?')"
                                    >
                                        Excluir
                                    </a>

                                {{/ifEquals}}

                            {{/if}}

                        </div>

                    </td>

                </tr>

                {{/each}}

            </tbody>

        </table>

    </div>

</main>

</body>

</html>